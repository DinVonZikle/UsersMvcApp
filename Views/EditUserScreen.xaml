<Page x:Class="UsersMvcApp.Views.EditUserScreen"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="EditUserScreen">

    <Grid Margin="20">
        <StackPanel Width="300" HorizontalAlignment="Left">
            <TextBlock Text="Редагування користувача"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 0 0 20" />

            <TextBlock Text="Ім'я" />
            <TextBox x:Name="NameTextBox" Margin="0 5 0 10" />

            <TextBlock Text="Прізвище" />
            <TextBox x:Name="LastNameTextBox" Margin="0 5 0 10" />

            <TextBlock Text="Вік" />
            <TextBox x:Name="AgeTextBox" Margin="0 5 0 20" />

            <StackPanel Orientation="Horizontal">
                <Button x:Name="SaveButton"
                        Content="Зберегти"
                        Width="120"
                        Height="35"
                        Margin="0 0 10 0" />

                <Button x:Name="CancelButton"
                        Content="Скасувати"
                        Width="120"
                        Height="35" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>