<Page x:Class="UsersMvcApp.Views.DetailsScreen"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DetailsScreen">
        
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Деталі користувача"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 0 0 20" />

            <TextBlock x:Name="IdTextBlock" FontSize="16" Margin="0 5" />
            <TextBlock x:Name="NameTextBlock" FontSize="16" Margin="0 5" />
            <TextBlock x:Name="LastNameTextBlock" FontSize="16" Margin="0 5" />
            <TextBlock x:Name="AgeTextBlock" FontSize="16" Margin="0 5" />

            <StackPanel Orientation="Horizontal" Margin="0 20 0 0">
                <Button x:Name="EditButton"
            Content="Редагувати"
            Width="120"
            Height="35"
            Margin="0 0 10 0" />

                <Button x:Name="DeleteButton"
            Content="Видалити"
            Width="120"
            Height="35"
            Margin="0 0 10 0" />

                <Button x:Name="BackButton"
            Content="Назад"
            Width="120"
            Height="35" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>